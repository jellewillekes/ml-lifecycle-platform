# Copy to tempo.env and grafana.env on the VM (or let Terraform render them).
# Values come from Secret Manager — see docs/runbooks/observability-setup.md.

# tempo.env
TEMPO_BUCKET=<project-id>-mlp-tempo
TEMPO_S3_ACCESS_KEY=<google_storage_hmac_key.access_id>
TEMPO_S3_SECRET_KEY=<google_storage_hmac_key.secret>

# grafana.env
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<rotated from Secret Manager>
