# Optional local overrides for the public M0 path.
# Docker Compose reads .env automatically.
# For local Python commands in your current shell, source the file explicitly if needed.

MLP_ENV=local
EXPERIMENT_NAME=breast-cancer-platform
MODEL_NAME=breast_cancer_clf
MLP_MODEL_SPEC_PATH=configs/models/breast_cancer_demo.yaml
LOG_LEVEL=INFO
CANARY_PCT=10
MLP_DATA_DIR=data
MLP_ARTIFACTS_DIR=artifacts
MLP_EVENT_LOG_PATH=artifacts/runtime-events.jsonl
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_REGISTRY_URI=http://localhost:5050
